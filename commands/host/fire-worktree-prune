#!/usr/bin/env bash
#ddev-generated

## Description: Delete DDEV projects whose worktree checkout is gone, such as after T3 deletes a thread
## Usage: fire-worktree-prune [--yes]
## Example: ddev fire-worktree-prune\nddev fire-worktree-prune --yes
## Flags: [{"Name":"yes","Shorthand":"y","Usage":"Delete what the dry run lists"}]

set -euo pipefail

# shellcheck source=fire-worktrees/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../fire-worktrees/lib.sh"

yes=false
case ${1:-} in
  '') ;;
  -y | --yes) yes=true ;;
  -h | --help)
    echo 'Usage: ddev fire-worktree-prune [--yes]'
    echo "Lists DDEV projects that fire-worktree-start created for this repository whose"
    echo 'checkout no longer exists. With --yes, deletes them, their databases and volumes.'
    exit 0
    ;;
  *) fw::die 'Usage: ddev fire-worktree-prune [--yes]' ;;
esac
[[ $# -le 1 ]] || fw::die 'Usage: ddev fire-worktree-prune [--yes]'

fw::context "$PWD"
registry=$(fw::registry_file)

# Names of environments that still have a checkout.
live=
while IFS= read -r line; do
  case $line in
    'worktree '*)
      path=${line#worktree }
      if [[ -d "$path" ]]; then
        live="$live$(fw::generated_name "$path")"$'\n'
      fi
      ;;
  esac
done < <(git -C "$FW_ROOT" worktree list --porcelain)

orphans=
stale=
if [[ -f "$registry" ]]; then
  while IFS=$'\t' read -r name path; do
    [[ -n "$name" ]] || continue
    if printf '%s' "$live" | grep -qxF "$name"; then
      continue
    fi
    if fw::has_environment "$name"; then
      orphans="$orphans$name"$'\t'"$path"$'\n'
    else
      stale="$stale$name"$'\n'
    fi
  done <"$registry"
fi

# Projects from the project-local commands this add-on replaced have no registry
# entry, and neither do volumes that earlier versions of prune left behind. Their
# names can't prove which clone created them, so only list them.
prefix=$(fw::slug "$(fw::setting "$FW_ROOT" WORKTREE_NAME_PREFIX "$(fw::primary_name)")" 12)
unregistered=
while IFS= read -r name; do
  [[ -n "$name" ]] || continue
  if printf '%s' "$live" | grep -qxF "$name" || printf '%s' "$orphans" | cut -f1 | grep -qxF "$name"; then
    continue
  fi
  if [[ -f "$registry" ]] && cut -f1 "$registry" | grep -qxF "$name"; then
    continue
  fi
  unregistered="$unregistered$name"$'\n'
done < <(
  {
    docker volume ls -q 2>/dev/null | sed -n -E "s/^($prefix-[a-z0-9-]+-[0-9]+)-(mariadb|mysql|postgres)\$/\1/p"
    docker volume ls --filter label=com.docker.compose.project --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null |
      sed -n -E "s/^ddev-($prefix-[a-z0-9-]+-[0-9]+)\$/\1/p"
  } | sort -u
)

if [[ -n "$stale" ]]; then
  while IFS= read -r name; do
    [[ -n "$name" ]] && fw::registry_remove "$name"
  done <<<"$stale"
fi

if [[ -z "$orphans" ]]; then
  echo 'No DDEV projects to prune.'
else
  echo 'DDEV projects whose worktree checkout is gone:'
  printf '%s' "$orphans" | awk -F '\t' '{ printf "  %s  (was %s)\n", $1, $2 }'
fi
if [[ -n "$unregistered" ]]; then
  printf '\nThese look like worktree projects from before this add-on, or volumes an earlier prune\nleft behind, but may belong to another clone. Check with ddev list. Delete any you no longer\nneed with ddev delete -Oy <name>, then docker volume rm any of its volumes that remain:\n'
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    printf '  %s\n' "$name"
    fw::project_volumes "$name" | sed 's/^/    /'
  done <<<"$unregistered"
fi
[[ -n "$orphans" ]] || exit 0

if [[ "$yes" == false ]]; then
  printf '\nDry run. Rerun with --yes to delete these projects, their databases and volumes.\n'
  exit 0
fi
while IFS=$'\t' read -r name path; do
  [[ -n "$name" ]] || continue
  fw::delete_project "$name"
  fw::registry_remove "$name"
done <<<"$orphans"
git -C "$FW_ROOT" worktree prune
echo 'Pruned.'
